# Database Configuration
DB_USERNAME=authuser
DB_PASSWORD=authpassword
DB_HOSTNAME=postgres
DB_PORT=5432
DB_NAME=authguard_db

# Database URL (override if needed)
DATABASE_URL=postgresql+asyncpg://authuser:authpassword@postgres:5432/authguard_db

# JWT Configuration
SECRET_KEY=your-secret-key-change-this-in-production-to-a-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=15

# Account Lockout Configuration
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Redis Configuration
REDIS_URL=redis://redis:6379/0
